# Environment for the web process (anc-web), set in its Node Project / PM2 configuration.
# The web app reads only these variables; see deploy.md section 6.1.
NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3000

# Server-side only. The web process calls the API on loopback (same server) so the API trusts the
# forwarded visitor address used for login throttling. Do not use the public domain here.
API_BASE_URL=http://127.0.0.1:3001/api/v1

# Public origin of the site; same-origin checks on mutating requests accept it behind the proxy.
APP_BASE_URL=https://posyandukkn26.my.id
