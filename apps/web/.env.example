# Web Environment Configuration - Production Setup
# copy this file to .env.production and fill in your actual credentials

# API SERVER URL (IMPORTANT)
NEXT_PUBLIC_API_URL=https://api.anc-reminder-kuncir.id/api/v1
API_FALLBACK_URL=https://api.anc-reminder-kuncir.id/api/v1

# APP BASE URL
NEXT_PUBLIC_APP_URL=https://anc-reminder-kuncir.id

# ENVIRONMENT CONFIG
NODE_ENV=production
NEXT_PUBLIC_ENV=production

# OPTIONAL: Regional settings
# NEXT_PUBLIC_TIMEZONE=Asia/Jakarta

# OPTIONAL: Features flag
# NEXT_PUBLIC_ENABLE_SEGMENT_REMOVAL=false
# NEXT_PUBLIC_ENABLE_ANALYTICS=true