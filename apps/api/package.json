{
  "name": "@anc/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file=../../.env --watch --enable-source-maps --import=tsx src/main.ts",
    "lint": "eslint src test --max-warnings=0",
    "provision:puskesmas": "node --env-file-if-exists=../../.env --import=tsx src/commands/provision-puskesmas.ts",
    "set:clinical-owner": "node --env-file-if-exists=../../.env --import=tsx src/commands/set-clinical-program-owner.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anc/config": "*",
    "@anc/contracts": "*",
    "@anc/database": "*",
    "@nestjs/common": "11.1.29",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/schedule": "6.1.3",
    "google-auth-library": "11.0.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "tsx": "4.23.11",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
