# Environment for the API process (anc-api), set in its Node Project / PM2 configuration.
# Every value below is a placeholder; generate real secrets as described in deploy.md section 5.
# Authoritative list and defaults: packages/config/src/environment.ts.
NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=3001
APP_BASE_URL=https://posyandukkn26.my.id
API_BASE_URL=https://posyandukkn26.my.id/api/v1
PRIMARY_TIMEZONE=Asia/Jakarta
LOG_LEVEL=info

# PostgreSQL. Production requires TLS (sslmode=require|verify-ca|verify-full) for non-local hosts.
# DATABASE_DIRECT_URL is read only by `npm run db:migrate:prod`, never by the running API.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Five distinct secrets. node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-hex-characters
MOTHER_SESSION_SECRET=replace-with-a-different-64-hex-characters
IDEMPOTENCY_SECRET=replace-with-a-third-64-hex-characters
# Base64 of exactly 32 random bytes. node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
NIK_ENCRYPTION_KEY=replace-with-base64-of-32-bytes
PUSH_TOKEN_ENCRYPTION_KEY=replace-with-a-different-base64-of-32-bytes

# Firebase Cloud Messaging is the only push channel. Without both values the API still starts, but
# every announcement fails with FCM_NOT_CONFIGURED. Paste the whole service-account JSON on one line.
FCM_PROJECT_ID=replace-with-firebase-project-id
FCM_SERVICE_ACCOUNT_JSON=

# The worker is the only process that creates and sends reminders.
SCHEDULER_ENABLED=false
WA_FALLBACK_ESCALATION_HOURS=24
