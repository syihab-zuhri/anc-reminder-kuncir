# API Environment Configuration - Supabase Database Setup
# copy this file to .env.production and fill in your actual credentials

# DATABASE CONNECTION (IMPORTANT)
DATABASE_URL=postgresql://postgres:[YOUR_ACTUAL_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_DIRECT_URL=postgresql://postgres:[YOUR_ACTUAL_PASSWORD]@db.eelgatcekddwxcofykzs.supabase.co:5432/postgres?sslmode=require

# PROJECT CONFIGURATION
PROJECT_REF=eelgatcekddwxcofykzs
PROJECT_NAME=anc-reminder-kuncir

# API ENDPOINTS
API_BASE_URL=https://api.anc-reminder-kuncir.id/api/v1
APP_BASE_URL=https://anc-reminder-kuncir.id

# SECURITY SECRETS (GENERATE NEW ONES)
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STAFF_SESSION_SECRET=GENERATE_THIS_64_CHAR_SECRET
MOTHER_SESSION_SECRET=GENERATE_THIS_64_CHAR_SECRET
JWT_SECRET_KEY=GENERATE_THIS_64_CHAR_SECRET
JWT_REFRESH_SECRET=GENERATE_THIS_64_CHAR_SECRET

# ENCRYPTION KEYS
NIK_ENCRYPTION_KEY=GENERATE_THIS_32_CHAR_BASE64_KEY
PUSH_TOKEN_ENCRYPTION_KEY=GENERATE_THIS_32_CHAR_BASE64_KEY

# IDEMPOTENCY COORDINATOR
IDEMPOTENCY_SECRET=GENERATE_THIS_64_CHAR_SECRET

# NOTIFICATION SETTINGS
WA_FALLBACK_ESCALATION_HOURS=24
PRIMARY_TIMEZONE=Asia/Jakarta
LOG_LEVEL=info

# FIREBASE CLOUD MESSAGING
FCM_PROJECT_ID=eelgatcekddwxcofykzs
FCM_SERVICE_ACCOUNT_JSON={
  "type":"[SERVICE_ACCOUNT_TYPE]",
  "project_id":"[PROJECT_ID]",
  "private_key_id":"[GET_FROM_FIREBASE]",
  "private_key":"[GET_FROM_FIREBASE]",
  "client_email":"[GET_FROM_FIREBASE]",
  "client_id":"[GET_FROM_FIREBASE]",
  "auth_uri":"https://accounts.google.com/o/oauth2/auth",
  "token_uri":"https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url":"[GET_FROM_FIREBASE]"
}

# NODE ENVIRONMENT
NODE_ENV=production

# SSL SETTINGS
ACCESS_CONTROL_CORS_MODE=with-timeout