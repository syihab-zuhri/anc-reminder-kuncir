# Copy to `keystore.properties` (git-ignored) and fill in real values.
# The same values can be supplied as environment variables instead:
#   ANC_ANDROID_KEYSTORE_FILE, ANC_ANDROID_KEYSTORE_PASSWORD,
#   ANC_ANDROID_KEY_ALIAS, ANC_ANDROID_KEY_PASSWORD
storeFile=/absolute/path/to/release.jks
storePassword=
keyAlias=
keyPassword=
